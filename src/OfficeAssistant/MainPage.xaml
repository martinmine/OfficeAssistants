<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OfficeAssistant.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,8,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Gallery: pick an assistant, like Office's Assistant dialog  -->
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Gallery" />

                <Border
                    Height="220"
                    Background="White"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Image
                        x:Name="PreviewImage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Assistant preview"
                        Stretch="Fill" />
                </Border>

                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.GalleryName, Mode=OneWay}" />
                <TextBlock
                    MinHeight="60"
                    Text="{x:Bind ViewModel.GalleryDescription, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.GalleryIsPreviewOnly, Mode=OneWay}"
                    Message="Only the gallery preview (.ACG) is available, which contains just the Wave animation. Add the matching .ACS file for the full assistant."
                    Severity="Informational" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        AutomationProperties.Name="Previous assistant"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        Content="&lt; Back" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.GalleryPosition, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Next assistant"
                        Command="{x:Bind ViewModel.NextCommand}"
                        Content="Next &gt;" />
                </Grid>

                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.UseAssistantCommand}"
                    Content="Use this assistant"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="AddFiles_Click"
                    Content="Add assistant files (.acs, .acg)..." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="0,0,12,0">
            <StackPanel Spacing="16">

                <!--  Active assistant options  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Options" />
                        <TextBlock>
                            <Run Text="Active assistant:" />
                            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.ActiveName, Mode=OneWay}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ActiveFiles, Mode=OneWay}" />
                        </TextBlock>
                        <ToggleSwitch Header="Show the Office Assistant" IsOn="{x:Bind ViewModel.IsAssistantShown, Mode=TwoWay}" />
                        <ToggleSwitch Header="Make sounds" IsOn="{x:Bind ViewModel.SoundsEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox
                                MinWidth="160"
                                Header="Pixel size"
                                SelectedIndex="{x:Bind ViewModel.ScaleIndex, Mode=TwoWay}">
                                <x:String>1x (original)</x:String>
                                <x:String>2x</x:String>
                                <x:String>3x</x:String>
                            </ComboBox>
                            <ComboBox
                                MinWidth="260"
                                Header="Assistant language"
                                ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Click the assistant to ask a question, drag it to move it, double-click to animate, right-click for its menu."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Balloons recreated from Office XP  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Balloons" />
                        <VariableSizedWrapGrid
                            ItemHeight="40"
                            ItemWidth="220"
                            Orientation="Horizontal">
                            <Button Command="{x:Bind ViewModel.ShowBalloonCommand}" CommandParameter="answer" Content="What would you like to do?" />
                            <Button Command="{x:Bind ViewModel.ShowBalloonCommand}" CommandParameter="autocomplete" Content="AutoComplete tip" />
                            <Button Command="{x:Bind ViewModel.ShowBalloonCommand}" CommandParameter="save" Content="Save changes alert" />
                            <Button Command="{x:Bind ViewModel.ShowBalloonCommand}" CommandParameter="letter" Content="Letter Wizard tip" />
                            <Button Command="{x:Bind ViewModel.ShowBalloonCommand}" CommandParameter="greeting" Content="Greeting" />
                            <Button Command="{x:Bind ViewModel.ShowBalloonCommand}" CommandParameter="reminder" Content="Reminder" />
                            <Button Command="{x:Bind ViewModel.ShowBalloonCommand}" CommandParameter="about" Content="About the assistant" />
                            <Button Command="{x:Bind ViewModel.CloseBalloonCommand}" Content="Close balloon" />
                        </VariableSizedWrapGrid>
                    </StackPanel>
                </Border>

                <!--  Animations from the character file  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Animations" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Playing:" />
                                    <Run Text="{x:Bind ViewModel.CurrentAnimation, Mode=OneWay}" />
                                </TextBlock>
                                <Button Command="{x:Bind ViewModel.AnimateCommand}" Content="Animate!" />
                            </StackPanel>
                        </Grid>
                        <GridView
                            IsItemClickEnabled="True"
                            ItemClick="Animation_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Animations, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Width="150"
                                        Padding="8,4"
                                        Text="{x:Bind}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Border>

                <!--  Localized strings from the character file  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Localized strings" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.LocalizedName, Mode=OneWay}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.LocalizedDescription, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Greetings" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Greetings, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Reminders" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Reminders, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
