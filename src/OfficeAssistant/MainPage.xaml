<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OfficeAssistant.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:OfficeAssistant"
    xmlns:vm="using:OfficeAssistant.Presentation"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,8,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Gallery: pick an assistant, like Office's Assistant dialog  -->
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Gallery" />

                <!--  The preview surface is always white, so keep its controls in the light theme  -->
                <Grid RequestedTheme="Light">
                    <Border
                        Height="220"
                        Background="White"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Image
                            x:Name="PreviewImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Assistant preview"
                            Stretch="Fill" />
                    </Border>
                    <ToggleButton
                        Margin="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind ViewModel.PreviewMuteLabel, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.PreviewMuted, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PreviewMuteLabel, Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PreviewMuteGlyph, Mode=OneWay}" />
                    </ToggleButton>
                </Grid>

                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.GalleryName, Mode=OneWay}" />
                <TextBlock
                    MinHeight="60"
                    Text="{x:Bind ViewModel.GalleryDescription, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.GalleryIsPreviewOnly, Mode=OneWay}"
                    Message="Only the gallery preview (.ACG) is available, which contains just the Wave animation. Add the matching .ACS file for the full assistant."
                    Severity="Informational" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        AutomationProperties.Name="Previous assistant"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        Content="&lt; Back" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.GalleryPosition, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Next assistant"
                        Command="{x:Bind ViewModel.NextCommand}"
                        Content="Next &gt;" />
                </Grid>

                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.UseAssistantCommand}"
                    Content="Use this assistant"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="AddFiles_Click"
                    Content="Add assistant files (.acs, .acg)..." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="0,0,12,0">
            <StackPanel Spacing="16">

                <!--  Active assistant options  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Options" />
                        <TextBlock>
                            <Run Text="Active assistant:" />
                            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.ActiveName, Mode=OneWay}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ActiveFiles, Mode=OneWay}" />
                        </TextBlock>
                        <ToggleSwitch Header="Show the Office Assistant" IsOn="{x:Bind ViewModel.IsAssistantShown, Mode=TwoWay}" />
                        <ToggleSwitch Header="Make sounds" IsOn="{x:Bind ViewModel.SoundsEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox
                                MinWidth="160"
                                Header="Pixel size"
                                SelectedIndex="{x:Bind ViewModel.ScaleIndex, Mode=TwoWay}">
                                <x:String>Automatic</x:String>
                                <x:String>1x (original)</x:String>
                                <x:String>2x</x:String>
                                <x:String>3x</x:String>
                            </ComboBox>
                            <ComboBox
                                MinWidth="260"
                                Header="Assistant language"
                                ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Click the assistant to ask a question, drag it to move it, double-click to animate, right-click for its menu."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Claude: the model the assistant talks with  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Claude" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.AskAssistantCommand}"
                                Content="Ask the assistant"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.NewConversationCommand}"
                                Content="New conversation" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The assistant answers with Claude. Click it, type a question and click Ask; it remembers the conversation until you start a new topic."
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox
                                Header="API key"
                                Password="{x:Bind ViewModel.ApiKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="sk-ant-..." />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.SaveApiKeyCommand}"
                                Content="Save key" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.ClearApiKeyCommand}"
                                Content="Remove key" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ApiKeyStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            MinWidth="260"
                            Header="Model"
                            IsEditable="True"
                            ItemsSource="{x:Bind ViewModel.Models}"
                            Text="{x:Bind ViewModel.Model, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!--  The active assistant's instructions and MCP servers  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                                <Run Text="Instructions and tools for" />
                                <Run Text="{x:Bind ViewModel.ActiveName, Mode=OneWay}" />
                            </TextBlock>
                            <Button
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.ReconnectMcpCommand}"
                                Content="Reconnect" />
                        </Grid>
                        <TextBox
                            MinHeight="72"
                            AcceptsReturn="True"
                            Header="Instructions"
                            PlaceholderText="Optional. For example: I work in the finance team, so prefer Excel examples."
                            Text="{x:Bind ViewModel.Instructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBox
                            MinHeight="160"
                            AcceptsReturn="True"
                            FontFamily="Cascadia Mono, Consolas"
                            Header="MCP servers (JSON)"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="{}{&#x0a;  &quot;filesystem&quot;: {&#x0a;    &quot;command&quot;: &quot;npx&quot;,&#x0a;    &quot;args&quot;: [&quot;-y&quot;, &quot;@modelcontextprotocol/server-filesystem&quot;, &quot;C:\\Users\\you\\Documents&quot;]&#x0a;  },&#x0a;  &quot;remote&quot;: { &quot;url&quot;: &quot;https://example.com/mcp&quot; }&#x0a;}"
                            Text="{x:Bind ViewModel.McpServersJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Same format as Claude Desktop's mcpServers: &quot;command&quot; with &quot;args&quot;, &quot;env&quot; and &quot;cwd&quot; for a local server, or &quot;url&quot; with &quot;headers&quot; for a remote one. The assistant asks before each tool call; add &quot;alwaysAllow&quot;: [&quot;tool_name&quot;] (or [&quot;*&quot;]) to skip asking, or &quot;disabled&quot;: true to turn a server off."
                            TextWrapping="Wrap" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasMcpError, Mode=OneWay}"
                            Message="{x:Bind ViewModel.McpError, Mode=OneWay}"
                            Severity="Error" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Command="{x:Bind ViewModel.SaveProfileCommand}"
                                Content="Save and connect"
                                Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.ProfileStatus, Mode=OneWay}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.McpServers, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpServerItem">
                                    <InfoBar
                                        Title="{x:Bind Name}"
                                        Margin="0,0,0,4"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{x:Bind Summary}"
                                        Severity="{x:Bind local:XamlConverters.ToSeverity(Status)}">
                                        <TextBlock
                                            Margin="0,0,0,12"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Tools}"
                                            TextWrapping="Wrap" />
                                    </InfoBar>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap">
                            <Run Text="Settings file:" />
                            <Run Text="{x:Bind ViewModel.SettingsPath}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  Animations from the character file  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Animations" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Playing:" />
                                    <Run Text="{x:Bind ViewModel.CurrentAnimation, Mode=OneWay}" />
                                </TextBlock>
                                <Button Command="{x:Bind ViewModel.AnimateCommand}" Content="Animate!" />
                            </StackPanel>
                        </Grid>
                        <GridView
                            IsItemClickEnabled="True"
                            ItemClick="Animation_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Animations, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Width="150"
                                        Padding="8,4"
                                        Text="{x:Bind}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
