<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OfficeAssistant.Balloon.BalloonTextInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Office Assistant question">

    <!-- Sits exactly over the balloon's Answer Wizard box while the user types. -->
    <Grid x:Name="Root" Background="White" RequestedTheme="Light">
        <Grid.Resources>
            <!-- Keep the Office XP box: white with a pale border, also while focused. -->
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#ECE9D8" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#ECE9D8" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#ECE9D8" />
            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#ECE9D8" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#ECE9D8" />
            <SolidColorBrush x:Key="TextControlBackground" Color="White" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
            <SolidColorBrush x:Key="TextControlForeground" Color="Black" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Black" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Black" />
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
        </Grid.Resources>

        <!-- Laid out in balloon pixels and scaled to the balloon's pixel size. -->
        <TextBox
            x:Name="Box"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AcceptsReturn="False"
            BorderThickness="1"
            CornerRadius="0"
            FontFamily="Tahoma"
            FontSize="13"
            IsSpellCheckEnabled="True"
            KeyDown="OnKeyDown"
            MinHeight="0"
            MinWidth="0"
            Padding="1,0,1,0"
            SelectionHighlightColor="#316AC5"
            TextWrapping="Wrap" />
    </Grid>
</Window>
