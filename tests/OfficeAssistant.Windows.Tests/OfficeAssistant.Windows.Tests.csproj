<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests that need Windows (GDI, DPAPI). They are skipped on other platforms. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AcsFormat.Tests\TestFiles.cs" Link="TestFiles.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OfficeAssistant.Core\OfficeAssistant.Core.csproj" />
    <ProjectReference Include="..\..\src\OfficeAssistant.Platform.Windows\OfficeAssistant.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
