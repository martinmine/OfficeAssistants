<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="ARM64" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/src/">
    <Project Path="src/AcsFormat/AcsFormat.csproj" />
    <Project Path="src/OfficeAssistant.Core/OfficeAssistant.Core.csproj" />
    <Project Path="src/OfficeAssistant.Mac/OfficeAssistant.Mac.csproj" />
    <Project Path="src/OfficeAssistant.Platform.Windows/OfficeAssistant.Platform.Windows.csproj" />
    <Project Path="src/OfficeAssistant.Presentation/OfficeAssistant.Presentation.csproj" />
    <Project Path="src/OfficeAssistant/OfficeAssistant.csproj">
      <Platform Solution="*|Any CPU" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|x86" Project="x86" />
      <Deploy />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/AcsFormat.Tests/AcsFormat.Tests.csproj" />
    <Project Path="tests/OfficeAssistant.Windows.Tests/OfficeAssistant.Windows.Tests.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <Project Path="tools/AcsTool/AcsTool.csproj" />
  </Folder>
</Solution>
